{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip --config knip.jsonc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:mutation": "stryker run stryker.config.json",
    "test:e2e": "astro build && playwright test",
    "stage": "node scripts/stage-site.mjs",
    "browsers": "node scripts/install-browsers.mjs",
    "verify": "npm run guards && npm run format:check && npm run lint && npm run knip && npm run check && npm run test && npm run build",
    "guards": "node scripts/guards/check-suppressions.mjs",
    "audit": "npm audit --audit-level=high",
    "ci:local": "node scripts/ci-local.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "0.0.83",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "satori": "0.35.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
