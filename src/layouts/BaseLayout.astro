---
/**
 * Page shell: <head> (SEO, Open Graph, JSON-LD, fonts, theme bootstrap) and site chrome.
 * The CSP <meta> is added by Astro's security.csp at build (ADR-0008).
 */
import { Font } from "astro:assets";

import Footer from "@/components/site/Footer.astro";
import Header from "@/components/site/Header.astro";
import SkipLink from "@/components/site/SkipLink.astro";
import { site } from "@/config/site";
import {
  absoluteUrl,
  ogImagePath,
  ogSize,
  pageTitle,
  serializeJsonLd,
} from "@/lib/seo";
import { withBase } from "@/lib/url";
import "@/styles/tokens.css";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Open Graph image key under /og/, e.g. "projects/portfolio" (ADR-0015). */
  image?: string;
  /** "article" for case studies. */
  type?: "website" | "article";
  /** schema.org data for this page (see src/lib/seo.ts). */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  noindex = false,
  image = "home",
  type = "website",
  jsonLd,
} = Astro.props;

const fullTitle = pageTitle(title);
const canonical = new URL(Astro.url.pathname, site.url).href;
const imageUrl = absoluteUrl(ogImagePath(image));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={withBase("/sitemap.xml")} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(ogSize.width)} />
    <meta property="og:image:height" content={String(ogSize.height)} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && (
      <script
        type="application/ld+json"
        is:inline
        set:html={serializeJsonLd(jsonLd)}
      ></script>
    )}
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="color-scheme" content="light dark" />
    <Font
      cssVariable="--font-serif"
      preload={[{ weight: "400", style: "normal" }]}
    />
    <Font
      cssVariable="--font-sans"
      preload={[{ weight: "400", style: "normal" }]}
    />
    <!-- Applies a saved theme before first paint; mirrors parseTheme in src/lib/theme.ts (ADR-0008). -->
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark")
          document.documentElement.dataset.theme = saved;
      } catch {
        // Storage blocked: fall back to the system theme via CSS.
      }
    </script>
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
