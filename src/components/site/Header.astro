---
/** Sticky site header (docs/design-system.md → Header, docs/information-architecture.md). */
import ThemeToggle from "@/components/site/ThemeToggle.astro";
import Button from "@/components/ui/Button.astro";
import { nav, site } from "@/config/site";
import { withBase } from "@/lib/url";
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={withBase("/")} aria-label={`${site.name}, home`}>
      <span class="mark" aria-hidden="true">
        {site.initials}
      </span>
      <span class="name">{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="links">
        {nav.map((item) => (
          <li>
            <a href={withBase(item.href)}>{item.label}</a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
      <Button href={withBase("/#contact")} size="sm">
        Contact me
      </Button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: color-mix(in srgb, var(--ground) 84%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
  }

  .bar {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 600;
    font-size: 0.96875rem;
    text-decoration: none;
  }

  .mark {
    width: 2.125rem;
    height: 2.125rem;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: var(--ink);
    color: var(--ground);
    font: 500 0.9375rem / 1 var(--serif);
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .links {
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
  }

  .links a {
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }

  .links a:hover {
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .links {
      display: none;
    }

    nav {
      gap: var(--space-3);
    }
  }

  @media (max-width: 420px) {
    .name {
      display: none;
    }
  }
</style>
