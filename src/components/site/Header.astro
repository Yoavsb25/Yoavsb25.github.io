---
/**
 * Sticky site header (docs/design-system.md → Header, docs/information-architecture.md).
 * Below 900px the links collapse into a <details> menu, which works without JS.
 */
import ThemeToggle from "@/components/site/ThemeToggle.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import { nav, site } from "@/config/site";
import { withBase } from "@/lib/url";
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={withBase("/")} aria-label={`${site.name}, home`}>
      <span class="mark" aria-hidden="true">
        {site.initials}
      </span>
      <span class="name">{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="links">
        {nav.map((item) => (
          <li>
            <a href={withBase(item.href)}>{item.label}</a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
      <details class="menu" data-menu>
        <summary aria-label="Menu">
          <Icon name="menu" size={18} />
          <span class="menu-text">Menu</span>
        </summary>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={withBase(item.href)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </details>
      <Button href={withBase("/#contact")} size="sm">
        Contact me
      </Button>
    </nav>
  </div>
</header>

<script>
  // Client JS justified: a <details> stays open after an in-page link jumps, covering
  // the section just reached. This closes it on a link tap, Escape, or a tap outside.
  // Without JS the menu still opens and its links work (docs/architecture.md).
  for (const menu of document.querySelectorAll<HTMLDetailsElement>(
    "[data-menu]",
  )) {
    const close = () => menu.removeAttribute("open");
    menu
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", close));
    menu.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !menu.open) return;
      close();
      menu.querySelector("summary")?.focus();
    });
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) close();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: color-mix(in srgb, var(--ground) 84%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
  }

  .bar {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 600;
    font-size: 0.96875rem;
    text-decoration: none;
  }

  .mark {
    width: 2.125rem;
    height: 2.125rem;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: var(--ink);
    color: var(--ground);
    font: 500 0.9375rem / 1 var(--serif);
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .links {
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
  }

  .links a {
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .links a:hover {
    color: var(--ink);
  }

  .menu {
    display: none;
  }

  .menu summary {
    height: 2.5rem;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    font-size: var(--text-small);
    list-style: none;
    cursor: pointer;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu ul {
    position: absolute;
    top: 100%;
    right: var(--gutter);
    padding: var(--space-2);
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow);
  }

  .menu a {
    display: block;
    padding: var(--space-3) var(--space-6) var(--space-3) var(--space-4);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .links {
      display: none;
    }

    .menu {
      display: block;
    }

    nav {
      gap: var(--space-3);
    }
  }

  @media (max-width: 420px) {
    .name {
      display: none;
    }

    .menu summary {
      padding-inline: var(--space-3);
    }

    .menu-text {
      display: none;
    }
  }
</style>
