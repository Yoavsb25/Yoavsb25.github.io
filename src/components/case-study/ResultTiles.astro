---
/** Three result tiles: big serif figure and a short label (docs/design-system.md → Result tile). */
import type { CollectionEntry } from "astro:content";

interface Props {
  results: CollectionEntry<"projects">["data"]["results"];
}

const { results } = Astro.props;
---

<ul class="results">
  {results.map((result) => (
    <li>
      <strong>{result.figure}</strong>
      <span>{result.label}</span>
    </li>
  ))}
</ul>

<style>
  .results {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 1.25rem 1.375rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
  }

  strong {
    display: block;
    color: var(--accent);
    font: 400 2.125rem / 1.1 var(--serif);
    letter-spacing: -0.02em;
  }

  span {
    display: block;
    margin-top: 6px;
    color: var(--ink-2);
    font-size: var(--text-small);
  }

  @media (max-width: 900px) {
    .results {
      grid-template-columns: 1fr;
    }
  }
</style>
