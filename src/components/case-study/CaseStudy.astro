---
/**
 * A case study in its fixed structure (docs/information-architecture.md → Case study;
 * ADR-0005): header, meta, visual, then problem, what I built, approach, results.
 * The default slot is the optional Markdown deep dive.
 */
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

import MetaRow from "@/components/case-study/MetaRow.astro";
import NextProject from "@/components/case-study/NextProject.astro";
import ResultTiles from "@/components/case-study/ResultTiles.astro";
import Toc from "@/components/case-study/Toc.astro";
import Icon from "@/components/ui/Icon.astro";
import Window from "@/components/ui/Window.astro";

interface Props {
  data: CollectionEntry<"projects">["data"];
  backHref: string;
  contactHref: string;
  next?: { title: string; href: string } | undefined;
  /** True when the Markdown body (passed in the default slot) has content. */
  hasDeepDive?: boolean;
}

const { data, backHref, contactHref, next, hasDeepDive = false } = Astro.props;

const sections = [
  { id: "problem", label: "The problem" },
  { id: "built", label: "What I built" },
  { id: "approach", label: "How I approached it" },
  { id: "results", label: "Results" },
  ...(hasDeepDive ? [{ id: "more", label: "More detail" }] : []),
];
---

<article class="case">
  <div class="wrap">
    <a class="back" href={backHref}>
      <Icon name="arrow-left" />
      Back to work
    </a>

    <header class="head">
      <span class="label">Case study · {data.kicker}</span>
      <h1 class="serif">{data.title}</h1>
      <p class="outcome">{data.outcome}</p>
    </header>

    <MetaRow meta={data.meta} />

    {data.cover ? (
      <Image
        class="visual cover"
        src={data.cover.src}
        alt={data.cover.alt}
        widths={[640, 1120]}
        sizes="(max-width: 1120px) 100vw, 1072px"
      />
    ) : (
      <Window rows={data.built} bars={0} size="lg" class="visual" />
    )}

    <div class="body">
      <Toc items={sections} />
      <div>
        <section class="part" id="problem" aria-labelledby="problem-title">
          <span class="label">The problem</span>
          <h2 id="problem-title" class="serif">
            Why it mattered
          </h2>
          <p>{data.problem}</p>
        </section>

        <section class="part" id="built" aria-labelledby="built-title">
          <span class="label">What I built</span>
          <h2 id="built-title" class="serif">
            The solution
          </h2>
          <ul>
            {data.built.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <section class="part" id="approach" aria-labelledby="approach-title">
          <span class="label">How I approached it</span>
          <h2 id="approach-title" class="serif">
            Plan, build, test, ship
          </h2>
          <p>{data.approach}</p>
        </section>

        <section class="part" id="results" aria-labelledby="results-title">
          <span class="label">Results</span>
          <h2 id="results-title" class="serif">
            What it achieved
          </h2>
          <ResultTiles results={data.results} />
        </section>

        {hasDeepDive && (
          <section class="part" id="more" aria-labelledby="more-title">
            <span class="label">More detail</span>
            <h2 id="more-title" class="serif">
              Behind the scenes
            </h2>
            <div class="prose">
              <slot />
            </div>
          </section>
        )}
      </div>
    </div>

    <NextProject next={next} contactHref={contactHref} />
  </div>
</article>

<style>
  .case {
    padding-block: 3.5rem 2.5rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: none;
  }

  .back:hover {
    color: var(--ink);
  }

  .head {
    max-width: 51.25rem;
    margin-top: 2.25rem;
  }

  h1 {
    margin-top: var(--space-4);
    font-size: var(--text-case);
    line-height: 1.02;
  }

  .outcome {
    max-width: 34em;
    margin-top: 1.25rem;
    color: var(--ink-2);
    font-size: clamp(1.1875rem, 2.2vw, 1.375rem);
  }

  .case :global(.visual) {
    margin-top: 2.75rem;
    border-radius: var(--radius-xl);
  }

  .case :global(.cover) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }

  .body {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 3.5rem;
    margin-top: var(--space-8);
  }

  .part {
    padding-bottom: var(--space-7);
  }

  .part + .part {
    padding-top: var(--space-7);
    border-top: 1px solid var(--line);
  }

  h2 {
    margin-top: var(--space-3);
    font-size: var(--text-h3);
    line-height: 1.1;
  }

  .part > p,
  .part > ul,
  .prose {
    max-width: 36em;
    margin-top: var(--space-4);
    color: var(--ink-2);
    font-size: var(--text-lede);
  }

  .part > ul {
    display: grid;
    gap: 10px;
    padding-left: 20px;
  }

  .part li::marker {
    color: var(--accent);
  }

  .prose :global(* + *) {
    margin-top: var(--space-4);
  }

  .prose :global(a) {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
