---
/**
 * Pill button (docs/design-system.md → Button). Renders a link when `href` is set,
 * otherwise a <button>. External links open in a new tab with noopener.
 */
import type { HTMLAttributes } from "astro/types";

import Icon, { type IconName } from "@/components/ui/Icon.astro";

type Variant = "primary" | "ghost";
type Size = "md" | "sm";

type Props = {
  variant?: Variant;
  size?: Size;
  href?: string;
  external?: boolean;
  download?: boolean;
  icon?: IconName;
  trailingArrow?: boolean;
  class?: string;
} & Omit<HTMLAttributes<"button">, "class">;

const {
  variant = "primary",
  size = "md",
  href,
  external = false,
  download = false,
  icon,
  trailingArrow = false,
  class: className,
  type = "button",
  ...rest
} = Astro.props;

const classes = ["btn", `btn-${variant}`, `btn-${size}`, className];
---

{href ? (
  <a
    class:list={classes}
    href={href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
    download={download || undefined}
  >
    {icon && <Icon name={icon} />}
    <slot />
    {trailingArrow && <Icon name="arrow-right" class="arrow" />}
  </a>
) : (
  <button class:list={classes} type={type} {...rest}>
    {icon && <Icon name={icon} />}
    <slot />
    {trailingArrow && <Icon name="arrow-right" class="arrow" />}
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font: 500 0.96875rem / 1 var(--sans);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      transform var(--dur-fast) ease,
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }

  .btn:active {
    transform: scale(0.98);
  }

  .btn-md {
    height: 3rem;
    padding-inline: 1.375rem;
  }

  .btn-sm {
    height: 2.5rem;
    padding-inline: 1.125rem;
    font-size: 0.90625rem;
  }

  .btn-primary {
    background: var(--ink);
    color: var(--ground);
  }

  .btn-primary:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .btn-ghost {
    background: var(--surface);
    border-color: var(--line);
    color: var(--ink);
  }

  .btn-ghost:hover {
    border-color: var(--ink-3);
  }

  .btn :global(.arrow) {
    transition: transform 180ms var(--ease);
  }

  .btn:hover :global(.arrow) {
    transform: translateX(3px);
  }
</style>
