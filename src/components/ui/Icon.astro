---
/**
 * Inline SVG icons (no icon font, no requests). Decorative by default: pass `label`
 * only when the icon is the sole content of a control.
 */
const paths = {
  "arrow-right": '<path d="M3 8h10m-4-4 4 4-4 4" />',
  "arrow-left": '<path d="M13 8H3m4-4L3 8l4 4" />',
  check: '<path d="m3.5 8.3 2.8 2.8L12.5 5" />',
  download: '<path d="M8 2.5v8m-3.5-3.5L8 10.5 11.5 7M3 13.5h10" />',
  sun: '<circle cx="8" cy="8" r="2.9" /><path d="M8 1.4v1.4M8 13.2v1.4M1.4 8h1.4M13.2 8h1.4M3.3 3.3l1 1M11.7 11.7l1 1M3.3 12.7l1-1M11.7 4.3l1-1" />',
  moon: '<path d="M13.2 9.9A5.6 5.6 0 0 1 6.1 2.8a5.6 5.6 0 1 0 7.1 7.1Z" />',
  mail: '<rect x="2" y="3.5" width="12" height="9" rx="1.5" /><path d="m2.5 4.5 5.5 4 5.5-4" />',
} as const;

const filled = {
  github:
    '<path d="M8 .2a8 8 0 0 0-2.5 15.6c.4 0 .5-.2.5-.4v-1.5c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.3 1.9.9 2.4.7 0-.5.3-.9.5-1.1-1.8-.2-3.6-.9-3.6-4 0-.9.3-1.6.8-2.1-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8a7.6 7.6 0 0 1 4 0c1.5-1 2.2-.8 2.2-.8.4 1.1.2 1.9.1 2.1.5.6.8 1.3.8 2.1 0 3.1-1.9 3.8-3.7 4 .3.3.6.8.6 1.5v2.2c0 .2.1.5.6.4A8 8 0 0 0 8 .2Z" />',
  linkedin:
    '<path d="M3.6 5.6H1.4V14h2.2V5.6ZM2.5 2a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6Zm11.6 7.2c0-2.3-1.2-3.8-3.2-3.8-1.1 0-1.9.6-2.2 1.2V5.6H6.6V14h2.2V9.6c0-1.2.5-2 1.5-2s1.4.7 1.4 2V14h2.3V9.2Z" />',
} as const;

export type IconName = keyof typeof paths | keyof typeof filled;

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 16, label, class: className } = Astro.props;
const isFilled = name in filled;
const markup = isFilled
  ? filled[name as keyof typeof filled]
  : paths[name as keyof typeof paths];
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 16 16"
  width={size}
  height={size}
  fill={isFilled ? "currentColor" : "none"}
  stroke={isFilled ? "none" : "currentColor"}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={markup}
/>

<style>
  .icon {
    flex: none;
  }
</style>
