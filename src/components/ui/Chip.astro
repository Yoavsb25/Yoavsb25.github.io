---
/** Pill label for skills and tags (docs/design-system.md → Skill chip). Not interactive. */
interface Props {
  size?: "md" | "sm";
}

const { size = "md" } = Astro.props;
---

<span class:list={["chip", `chip-${size}`]}>
  <slot />
</span>

<style>
  .chip {
    display: inline-block;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink-2);
    line-height: 1.3;
  }

  .chip-md {
    padding: 7px 14px;
    font-size: 0.90625rem;
  }

  .chip-sm {
    padding: 4px 10px;
    font-size: 0.8125rem;
    background: var(--ground);
  }
</style>
