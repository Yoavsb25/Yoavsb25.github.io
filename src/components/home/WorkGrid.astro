---
/**
 * Selected work (docs/information-architecture.md → Home 3; design-system → Work card).
 * Each card is one link to its case study; the featured card spans the grid.
 * Cover image when present; otherwise the Window illustration (same as case study).
 */
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

import Chip from "@/components/ui/Chip.astro";
import Icon from "@/components/ui/Icon.astro";
import Window from "@/components/ui/Window.astro";
import { workGridColumns } from "@/lib/content";

interface Props {
  projects: { entry: CollectionEntry<"projects">; href: string }[];
}

const { projects } = Astro.props;
const columns = workGridColumns(projects.map((p) => p.entry));
---

<section class="section" id="projects" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="label">Selected work</span>
        <h2 id="work-title" class="serif">
          Real projects, <em>shipped</em>.
        </h2>
      </div>
    </div>

    <ul class:list={["grid", `cols-${columns}`]}>
      {projects.map(({ entry: { data }, href }) => (
        <li class:list={{ featured: data.featured }}>
          <a class="card" href={href}>
            {/* Decorative here: the link is already named by the card text; the case study uses cover.alt. */}
            {data.cover ? (
              <Image
                class="cover"
                src={data.cover.src}
                alt=""
                widths={data.featured ? [640, 1120] : [400, 720]}
                sizes={
                  data.featured
                    ? "(max-width: 900px) 100vw, 600px"
                    : "(max-width: 900px) 100vw, 360px"
                }
                loading="lazy"
              />
            ) : (
              <Window
                rows={data.featured ? data.built : []}
                bars={data.featured ? 2 : 3}
                size={data.featured ? "lg" : "md"}
              />
            )}
            <div class="body">
              <span class="label">{data.kicker}</span>
              <h3 class="serif">{data.title}</h3>
              <p>{data.summary}</p>
              <ul class="tags" aria-label="Topics">
                {data.tags.map((tag) => (
                  <li>
                    <Chip size="sm">{tag}</Chip>
                  </li>
                ))}
              </ul>
              <span class="more">
                Read the case study
                <Icon name="arrow-right" size={15} class="arrow" />
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-y);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-5);
  }

  h2 {
    margin-top: 14px;
    font-size: var(--text-h2);
    line-height: 1.05;
  }

  .section-head p {
    max-width: 26em;
    color: var(--ink-2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
  }

  .cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cols-1 {
    grid-template-columns: 1fr;
  }

  .grid > li {
    display: grid;
  }

  .featured {
    grid-column: 1 / -1;
  }

  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform var(--dur-base) var(--ease),
      box-shadow var(--dur-base) var(--ease),
      border-color var(--dur-base) var(--ease);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--line));
  }

  .card:focus-visible {
    border-radius: var(--radius-lg);
  }

  .featured .card {
    grid-template-columns: 1.2fr 1fr;
    grid-template-rows: none;
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    min-height: 13.75rem;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
    transition: transform var(--dur-base) var(--ease);
  }

  .featured .cover {
    height: 100%;
    min-height: 20rem;
    aspect-ratio: auto;
    border-bottom: none;
    border-inline-end: 1px solid var(--line);
  }

  .card:hover .cover {
    transform: scale(1.02);
  }

  .body {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  h3 {
    margin-top: 4px;
    font-size: var(--text-h3);
    line-height: 1.12;
  }

  .body p {
    color: var(--ink-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    color: var(--accent);
    font-size: var(--text-small);
    font-weight: 500;
  }

  .more :global(.arrow) {
    transition: transform var(--dur-fast) var(--ease);
  }

  .card:hover .more :global(.arrow) {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .grid.grid,
    .featured .card {
      grid-template-columns: 1fr;
    }

    .featured .cover {
      height: auto;
      min-height: 13.75rem;
      aspect-ratio: 16 / 10;
      border-inline-end: none;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
