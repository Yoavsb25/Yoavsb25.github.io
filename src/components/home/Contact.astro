---
/**
 * Contact (docs/information-architecture.md → Home 5).
 * Email me / LinkedIn / GitHub / Download CV — no client JS.
 */
import type { CollectionEntry } from "astro:content";

import Emphasized from "@/components/home/Emphasized.astro";
import Button from "@/components/ui/Button.astro";

interface Props {
  contact: CollectionEntry<"profile">["data"]["contact"];
  email: string;
  linkedin: string;
  github: string;
  cvHref: string;
}

const { contact, email, linkedin, github, cvHref } = Astro.props;
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <span class="label">Contact</span>
    <h2 id="contact-title" class="serif">
      <Emphasized text={contact.headline} />
    </h2>
    <p class="line">{contact.line}</p>
    <div class="links">
      <Button href={`mailto:${email}`} trailingArrow>
        Email me
      </Button>
      <Button href={linkedin} variant="ghost" icon="linkedin" external>
        LinkedIn
      </Button>
      <Button href={github} variant="ghost" icon="github" external>
        GitHub
      </Button>
      <Button href={cvHref} variant="ghost" icon="download" download>
        Download CV
      </Button>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section-y);
    background: linear-gradient(to bottom, var(--ground), var(--ground-2));
    text-align: center;
  }

  h2 {
    max-width: 14ch;
    margin: var(--space-4) auto 0;
    font-size: var(--text-h2);
    line-height: 1.05;
  }

  .line {
    max-width: 32em;
    margin: 1.25rem auto 0;
    color: var(--ink-2);
    font-size: var(--text-lede);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: 2.25rem;
  }
</style>
