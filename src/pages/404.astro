---
/** Not found. GitHub Pages serves 404.html for any unknown path under the site. */
import Button from "@/components/ui/Button.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/url";
---

<BaseLayout
  title="Page not found"
  description="This page doesn't exist. Head back to the home page or see my work."
  noindex
>
  <section class="wrap missing">
    <span class="label">404</span>
    <h1 class="serif">
      This page doesn't <em>exist</em>.
    </h1>
    <p>
      The link may be old or mistyped. Everything I've built is on the home
      page.
    </p>
    <div class="actions">
      <Button href={withBase("/")} trailingArrow>
        Go to the home page
      </Button>
      <Button href={withBase("/#projects")} variant="ghost">
        See my work
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  .missing {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    padding-block: var(--space-10);
  }

  h1 {
    font-size: var(--text-case);
    line-height: 1.02;
  }

  p {
    max-width: 34em;
    color: var(--ink-2);
    font-size: var(--text-lede);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
