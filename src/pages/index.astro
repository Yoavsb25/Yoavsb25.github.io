---
/** Home: hero, How I work, Selected work, Resume, Contact (docs/information-architecture.md → Home). */
import { getCollection, getEntry } from "astro:content";

import Contact from "@/components/home/Contact.astro";
import Hero from "@/components/home/Hero.astro";
import HowIWork from "@/components/home/HowIWork.astro";
import Resume from "@/components/home/Resume.astro";
import WorkGrid from "@/components/home/WorkGrid.astro";
import { site } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  assertStages,
  byOrder,
  defaultStage,
  projectPath,
  publishedProjects,
} from "@/lib/content";
import { personJsonLd } from "@/lib/seo";
import { withBase } from "@/lib/url";

const profile = await getEntry("profile", "profile");
if (!profile) throw new Error("src/content/profile.yaml is missing");

const stages = byOrder(await getCollection("stages"));
assertStages(stages);
const selected = defaultStage(stages);
const projects = publishedProjects(await getCollection("projects")).map(
  (entry) => ({ entry, href: withBase(projectPath(entry.id)) }),
);
const experience = byOrder(await getCollection("experience"));
const cvHref = withBase(site.cvPath);
---

<BaseLayout jsonLd={personJsonLd()}>
  <Hero
    profile={profile.data}
    name={site.name}
    workHref={withBase("/#projects")}
  />
  <HowIWork
    section={profile.data.sections.how}
    stages={stages}
    selected={selected ? stages.indexOf(selected) : 0}
  />
  <WorkGrid section={profile.data.sections.work} projects={projects} />
  <Resume
    section={profile.data.sections.resume}
    entries={experience}
    skillGroups={profile.data.skillGroups}
    cvHref={cvHref}
  />
  <Contact
    contact={profile.data.contact}
    email={site.email}
    linkedin={site.socials.linkedin}
    github={site.socials.github}
    cvHref={cvHref}
  />
</BaseLayout>
